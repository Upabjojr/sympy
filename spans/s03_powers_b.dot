digraph G {
  graph [fontname="DejaVu Sans", fontsize=12, labelloc=t, nodesep=0.15, ranksep=0.35, compound=true];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [arrowhead=none, color="#777777"];
  label=<<b>A parenthesised argument ends the function; a number starts an argument that goes on</b>>;
  subgraph cluster_c0 {
    label=<<font face="DejaVu Sans Mono">\sin(x)^2   =   sin(x)**2</font>>; labeljust=l; style="rounded"; color="#bbbbbb"; margin=12;
  c0n0 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>latex_string</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">\sin(x)^2</font></td></tr><tr><td><font point-size="8" color="#888888">0:9</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c0n1 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>superscript</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">\sin(x)^2</font></td></tr><tr><td><font point-size="8" color="#888888">0:9</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c0n2 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>trigonometric_function</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">\sin(x)</font></td></tr><tr><td><font point-size="8" color="#888888">0:7</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c0n3 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">FUNC_TRIG</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>\sin</b></font></td></tr><tr><td><font point-size="8" color="#888888">0:4</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n2 -> c0n3;
  c0n4 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>group_round_parentheses</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">(x)</font></td></tr><tr><td><font point-size="8" color="#888888">4:7</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#dbe9f6"];
  c0n5 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">L_PAREN</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>(</b></font></td></tr><tr><td><font point-size="8" color="#888888">4:5</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n4 -> c0n5;
  c0n6 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">SYMBOL</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>x</b></font></td></tr><tr><td><font point-size="8" color="#888888">5:6</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n4 -> c0n6;
  c0n7 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">R_PAREN</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>)</b></font></td></tr><tr><td><font point-size="8" color="#888888">6:7</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n4 -> c0n7;
  c0n2 -> c0n4;
  c0n1 -> c0n2;
  c0n8 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">CARET</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>^</b></font></td></tr><tr><td><font point-size="8" color="#888888">7:8</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n1 -> c0n8;
  c0n9 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>number</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">2</font></td></tr><tr><td><font point-size="8" color="#888888">8:9</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c0n10 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">&#x27;2&#x27;</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>2</b></font></td></tr><tr><td><font point-size="8" color="#888888">8:9</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n9 -> c0n10;
  c0n1 -> c0n9;
  c0n0 -> c0n1;
  c0chart [shape=plaintext, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3"><tr><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>\</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>s</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>i</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>n</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>(</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>x</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>)</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>^</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>2</b></font></td></tr><tr><td border="0"><font point-size="7" color="#888888">0</font></td><td border="0"><font point-size="7" color="#888888">1</font></td><td border="0"><font point-size="7" color="#888888">2</font></td><td border="0"><font point-size="7" color="#888888">3</font></td><td border="0"><font point-size="7" color="#888888">4</font></td><td border="0"><font point-size="7" color="#888888">5</font></td><td border="0"><font point-size="7" color="#888888">6</font></td><td border="0"><font point-size="7" color="#888888">7</font></td><td border="0"><font point-size="7" color="#888888">8</font></td></tr><tr><td border="1" colspan="9" bgcolor="#fff3b0"><font point-size="9">latex_string</font></td></tr><tr><td border="1" colspan="9" bgcolor="#fff3b0"><font point-size="9">superscript</font></td></tr><tr><td border="1" colspan="7" bgcolor="#fff3b0"><font point-size="9">trigonometric_function</font></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">CARET</font></td><td border="1" colspan="1" bgcolor="#fff3b0"><font point-size="9">number</font></td></tr><tr><td border="1" colspan="4" bgcolor="#e8e8e8"><font point-size="9">FUNC_TRIG</font></td><td border="1" colspan="3" bgcolor="#dbe9f6"><font point-size="9">group_round_parentheses</font></td><td border="0" colspan="1"></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">&#x27;2&#x27;</font></td></tr><tr><td border="0" colspan="4"></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">L_PAREN</font></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">SYMBOL</font></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">R_PAREN</font></td><td border="0" colspan="2"></td></tr></table>>];
  c0n3 -> c0chart [style=invis, weight=0];
  c0n5 -> c0chart [style=invis, weight=0];
  c0n6 -> c0chart [style=invis, weight=0];
  c0n7 -> c0chart [style=invis, weight=0];
  c0n8 -> c0chart [style=invis, weight=0];
  c0n10 -> c0chart [style=invis, weight=0];
  }
  subgraph cluster_c1 {
    label=<<font face="DejaVu Sans Mono">\sin 2(x+1)^2   =   sin(2*(x + 1)**2)</font>>; labeljust=l; style="rounded"; color="#bbbbbb"; margin=12;
  c1n0 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>latex_string</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">\sin 2(x+1)^2</font></td></tr><tr><td><font point-size="8" color="#888888">0:13</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c1n1 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>trigonometric_function</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">\sin 2(x+1)^2</font></td></tr><tr><td><font point-size="8" color="#888888">0:13</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c1n2 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">FUNC_TRIG</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>\sin</b></font></td></tr><tr><td><font point-size="8" color="#888888">0:4</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c1n1 -> c1n2;
