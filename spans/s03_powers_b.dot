  c1n10 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">SYMBOL</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>x</b></font></td></tr><tr><td><font point-size="8" color="#888888">7:8</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c1n9 -> c1n10;
