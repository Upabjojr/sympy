  c1n4 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>number</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">2</font></td></tr><tr><td><font point-size="8" color="#888888">5:6</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c1n5 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">&#x27;2&#x27;</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>2</b></font></td></tr><tr><td><font point-size="8" color="#888888">5:6</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c1n4 -> c1n5;
