  c1n6 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>superscript</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">(x+1)^2</font></td></tr><tr><td><font point-size="8" color="#888888">6:13</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c1n7 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>group_round_parentheses</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">(x+1)</font></td></tr><tr><td><font point-size="8" color="#888888">6:11</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#dbe9f6"];
