digraph G {
  graph [fontname="DejaVu Sans", fontsize=12, labelloc=t, nodesep=0.15, ranksep=0.35, compound=true];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [arrowhead=none, color="#777777"];
  label=<<b>A power after a bare argument belongs to the argument; a power on the function name does not</b>>;
  subgraph cluster_c0 {
    label=<<font face="DejaVu Sans Mono">\sin x^2   =   sin(x**2)</font>>; labeljust=l; style="rounded"; color="#bbbbbb"; margin=12;
  c0n0 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>latex_string</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">\sin x^2</font></td></tr><tr><td><font point-size="8" color="#888888">0:8</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c0n1 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>trigonometric_function</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">\sin x^2</font></td></tr><tr><td><font point-size="8" color="#888888">0:8</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c0n2 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">FUNC_TRIG</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>\sin</b></font></td></tr><tr><td><font point-size="8" color="#888888">0:4</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n1 -> c0n2;
  c0n3 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>superscript</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">x^2</font></td></tr><tr><td><font point-size="8" color="#888888">5:8</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c0n4 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">SYMBOL</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>x</b></font></td></tr><tr><td><font point-size="8" color="#888888">5:6</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n3 -> c0n4;
  c0n5 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">CARET</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>^</b></font></td></tr><tr><td><font point-size="8" color="#888888">6:7</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n3 -> c0n5;
  c0n6 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>number</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">2</font></td></tr><tr><td><font point-size="8" color="#888888">7:8</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c0n7 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">&#x27;2&#x27;</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>2</b></font></td></tr><tr><td><font point-size="8" color="#888888">7:8</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n6 -> c0n7;
  c0n3 -> c0n6;
  c0n1 -> c0n3;
  c0n0 -> c0n1;
  c0chart [shape=plaintext, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3"><tr><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>\</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>s</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>i</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>n</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>&nbsp;</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>x</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>^</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>2</b></font></td></tr><tr><td border="0"><font point-size="7" color="#888888">0</font></td><td border="0"><font point-size="7" color="#888888">1</font></td><td border="0"><font point-size="7" color="#888888">2</font></td><td border="0"><font point-size="7" color="#888888">3</font></td><td border="0"><font point-size="7" color="#888888">4</font></td><td border="0"><font point-size="7" color="#888888">5</font></td><td border="0"><font point-size="7" color="#888888">6</font></td><td border="0"><font point-size="7" color="#888888">7</font></td></tr><tr><td border="1" colspan="8" bgcolor="#fff3b0"><font point-size="9">latex_string</font></td></tr><tr><td border="1" colspan="8" bgcolor="#fff3b0"><font point-size="9">trigonometric_function</font></td></tr><tr><td border="1" colspan="4" bgcolor="#e8e8e8"><font point-size="9">FUNC_TRIG</font></td><td border="0" colspan="1"></td><td border="1" colspan="3" bgcolor="#fff3b0"><font point-size="9">superscript</font></td></tr><tr><td border="0" colspan="5"></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">SYMBOL</font></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">CARET</font></td><td border="1" colspan="1" bgcolor="#fff3b0"><font point-size="9">number</font></td></tr><tr><td border="0" colspan="7"></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">&#x27;2&#x27;</font></td></tr></table>>];
  c0n2 -> c0chart [style=invis, weight=0];
  c0n4 -> c0chart [style=invis, weight=0];
  c0n5 -> c0chart [style=invis, weight=0];
  c0n7 -> c0chart [style=invis, weight=0];
  }
  subgraph cluster_c1 {
    label=<<font face="DejaVu Sans Mono">\sin^2 x   =   sin(x)**2</font>>; labeljust=l; style="rounded"; color="#bbbbbb"; margin=12;
  c1n0 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>latex_string</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">\sin^2 x</font></td></tr><tr><td><font point-size="8" color="#888888">0:8</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c1n1 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>trigonometric_function_power</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">\sin^2 x</font></td></tr><tr><td><font point-size="8" color="#888888">0:8</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c1n2 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">FUNC_TRIG</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>\sin</b></font></td></tr><tr><td><font point-size="8" color="#888888">0:4</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c1n1 -> c1n2;
  c1n3 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">CARET</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>^</b></font></td></tr><tr><td><font point-size="8" color="#888888">4:5</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c1n1 -> c1n3;
  c1n4 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>number</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">2</font></td></tr><tr><td><font point-size="8" color="#888888">5:6</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c1n5 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">&#x27;2&#x27;</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>2</b></font></td></tr><tr><td><font point-size="8" color="#888888">5:6</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c1n4 -> c1n5;
  c1n1 -> c1n4;
  c1n6 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">SYMBOL</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>x</b></font></td></tr><tr><td><font point-size="8" color="#888888">7:8</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c1n1 -> c1n6;
  c1n0 -> c1n1;
  c1chart [shape=plaintext, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3"><tr><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>\</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>s</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>i</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>n</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>^</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>2</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>&nbsp;</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>x</b></font></td></tr><tr><td border="0"><font point-size="7" color="#888888">0</font></td><td border="0"><font point-size="7" color="#888888">1</font></td><td border="0"><font point-size="7" color="#888888">2</font></td><td border="0"><font point-size="7" color="#888888">3</font></td><td border="0"><font point-size="7" color="#888888">4</font></td><td border="0"><font point-size="7" color="#888888">5</font></td><td border="0"><font point-size="7" color="#888888">6</font></td><td border="0"><font point-size="7" color="#888888">7</font></td></tr><tr><td border="1" colspan="8" bgcolor="#fff3b0"><font point-size="9">latex_string</font></td></tr><tr><td border="1" colspan="8" bgcolor="#fff3b0"><font point-size="9">trigonometric_function_power</font></td></tr><tr><td border="1" colspan="4" bgcolor="#e8e8e8"><font point-size="9">FUNC_TRIG</font></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">CARET</font></td><td border="1" colspan="1" bgcolor="#fff3b0"><font point-size="9">number</font></td><td border="0" colspan="1"></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">SYMBOL</font></td></tr><tr><td border="0" colspan="5"></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">&#x27;2&#x27;</font></td><td border="0" colspan="2"></td></tr></table>>];
  c1n2 -> c1chart [style=invis, weight=0];
  c1n3 -> c1chart [style=invis, weight=0];
  c1n5 -> c1chart [style=invis, weight=0];
  c1n6 -> c1chart [style=invis, weight=0];
  }
}