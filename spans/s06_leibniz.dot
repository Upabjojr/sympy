  c0n4 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">L_BRACE</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>{</b></font></td></tr><tr><td><font point-size="8" color="#888888">5:6</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
