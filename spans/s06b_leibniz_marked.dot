digraph G {
  graph [fontname="DejaVu Sans", fontsize=12, labelloc=t, nodesep=0.15, ranksep=0.35, compound=true];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [arrowhead=none, color="#777777"];
  label=<<b>The same tree after the pre-pass: fraction becomes leibniz_fraction holding the factors</b>>;
  subgraph cluster_c0 {
    label=<<font face="DejaVu Sans Mono">\frac{d^2 y}{dx^2}   after _mark_leibniz_notation   =   Derivative(y, (x, 2))</font>>; labeljust=l; style="rounded"; color="#bbbbbb"; margin=12;
  c0n0 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>latex_string</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">d^2 y}{dx^2</font></td></tr><tr><td><font point-size="8" color="#888888">6:17</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c0n1 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>leibniz_fraction</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">d^2 y}{dx^2</font></td></tr><tr><td><font point-size="8" color="#888888">6:17</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#c8e6c9"];
  c0n2 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>superscript</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">d^2</font></td></tr><tr><td><font point-size="8" color="#888888">6:9</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c0n3 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">SYMBOL</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>d</b></font></td></tr><tr><td><font point-size="8" color="#888888">6:7</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n2 -> c0n3;
  c0n4 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">CARET</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>^</b></font></td></tr><tr><td><font point-size="8" color="#888888">7:8</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n2 -> c0n4;
  c0n5 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>number</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">2</font></td></tr><tr><td><font point-size="8" color="#888888">8:9</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c0n6 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">&#x27;2&#x27;</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>2</b></font></td></tr><tr><td><font point-size="8" color="#888888">8:9</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n5 -> c0n6;
  c0n2 -> c0n5;
  c0n1 -> c0n2;
  c0n7 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">SYMBOL</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>y</b></font></td></tr><tr><td><font point-size="8" color="#888888">10:11</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n1 -> c0n7;
  c0n8 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>superscript</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">x^2</font></td></tr><tr><td><font point-size="8" color="#888888">14:17</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c0n9 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">SYMBOL</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>x</b></font></td></tr><tr><td><font point-size="8" color="#888888">14:15</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n8 -> c0n9;
  c0n10 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">CARET</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>^</b></font></td></tr><tr><td><font point-size="8" color="#888888">15:16</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n8 -> c0n10;
  c0n11 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>number</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">2</font></td></tr><tr><td><font point-size="8" color="#888888">16:17</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c0n12 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">&#x27;2&#x27;</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>2</b></font></td></tr><tr><td><font point-size="8" color="#888888">16:17</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n11 -> c0n12;
  c0n8 -> c0n11;
  c0n1 -> c0n8;
  c0n0 -> c0n1;
  c0chart [shape=plaintext, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3"><tr><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>\</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>f</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>r</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>a</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>c</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>{</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>d</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>^</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>2</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>&nbsp;</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>y</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>}</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>{</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>d</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>x</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>^</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>2</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>}</b></font></td></tr><tr><td border="0"><font point-size="7" color="#888888">0</font></td><td border="0"><font point-size="7" color="#888888">1</font></td><td border="0"><font point-size="7" color="#888888">2</font></td><td border="0"><font point-size="7" color="#888888">3</font></td><td border="0"><font point-size="7" color="#888888">4</font></td><td border="0"><font point-size="7" color="#888888">5</font></td><td border="0"><font point-size="7" color="#888888">6</font></td><td border="0"><font point-size="7" color="#888888">7</font></td><td border="0"><font point-size="7" color="#888888">8</font></td><td border="0"><font point-size="7" color="#888888">9</font></td><td border="0"><font point-size="7" color="#888888">10</font></td><td border="0"><font point-size="7" color="#888888">11</font></td><td border="0"><font point-size="7" color="#888888">12</font></td><td border="0"><font point-size="7" color="#888888">13</font></td><td border="0"><font point-size="7" color="#888888">14</font></td><td border="0"><font point-size="7" color="#888888">15</font></td><td border="0"><font point-size="7" color="#888888">16</font></td><td border="0"><font point-size="7" color="#888888">17</font></td></tr><tr><td border="0" colspan="6"></td><td border="1" colspan="11" bgcolor="#fff3b0"><font point-size="9">latex_string</font></td><td border="0" colspan="1"></td></tr><tr><td border="0" colspan="6"></td><td border="1" colspan="11" bgcolor="#c8e6c9"><font point-size="9">leibniz_fraction</font></td><td border="0" colspan="1"></td></tr><tr><td border="0" colspan="6"></td><td border="1" colspan="3" bgcolor="#fff3b0"><font point-size="9">superscript</font></td><td border="0" colspan="1"></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">SYMBOL</font></td><td border="0" colspan="3"></td><td border="1" colspan="3" bgcolor="#fff3b0"><font point-size="9">superscript</font></td><td border="0" colspan="1"></td></tr><tr><td border="0" colspan="6"></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">SYMBOL</font></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">CARET</font></td><td border="1" colspan="1" bgcolor="#fff3b0"><font point-size="9">number</font></td><td border="0" colspan="5"></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">SYMBOL</font></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">CARET</font></td><td border="1" colspan="1" bgcolor="#fff3b0"><font point-size="9">number</font></td><td border="0" colspan="1"></td></tr><tr><td border="0" colspan="8"></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">&#x27;2&#x27;</font></td><td border="0" colspan="7"></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">&#x27;2&#x27;</font></td><td border="0" colspan="1"></td></tr></table>>];
  c0n3 -> c0chart [style=invis, weight=0];
  c0n4 -> c0chart [style=invis, weight=0];
  c0n6 -> c0chart [style=invis, weight=0];
  c0n7 -> c0chart [style=invis, weight=0];
  c0n9 -> c0chart [style=invis, weight=0];
  c0n10 -> c0chart [style=invis, weight=0];
  c0n12 -> c0chart [style=invis, weight=0];
