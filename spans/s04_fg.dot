digraph G {
  graph [fontname="DejaVu Sans", fontsize=12, labelloc=t, nodesep=0.15, ranksep=0.35, compound=true];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [arrowhead=none, color="#777777"];
  label=<<b>The two readings of f(x)g(x)</b>>;
  subgraph cluster_c0 {
    label=<<font face="DejaVu Sans Mono">f(x)g(x)   reading 1 of 2: f*g*x**2</font>>; labeljust=l; style="rounded"; color="#bbbbbb"; margin=12;
  c0n0 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>latex_string</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">f(x)g(x)</font></td></tr><tr><td><font point-size="8" color="#888888">0:8</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c0n1 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>adjacent_expressions</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">f(x)g(x)</font></td></tr><tr><td><font point-size="8" color="#888888">0:8</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c0n2 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">SYMBOL</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>f</b></font></td></tr><tr><td><font point-size="8" color="#888888">0:1</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
