  c0n9 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">SYMBOL</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>g</b></font></td></tr><tr><td><font point-size="8" color="#888888">4:5</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
