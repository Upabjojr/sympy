  c0n4 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>group_round_parentheses</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">(x)</font></td></tr><tr><td><font point-size="8" color="#888888">1:4</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#dbe9f6"];
