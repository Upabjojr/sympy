digraph G {
  graph [fontname="DejaVu Sans", fontsize=12, labelloc=t, nodesep=0.15, ranksep=0.35, compound=true];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [arrowhead=none, color="#777777"];
  label=<<b>\operatorname: one terminal for the whole command, resolved by the transformer</b>>;
  subgraph cluster_c0 {
    label=<<font face="DejaVu Sans Mono">\operatorname{sin}^{-1} x   =   asin(x)</font>>; labeljust=l; style="rounded"; color="#bbbbbb"; margin=12;
