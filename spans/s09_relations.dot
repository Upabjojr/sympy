digraph G {
  graph [fontname="DejaVu Sans", fontsize=12, labelloc=t, nodesep=0.15, ranksep=0.35, compound=true];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [arrowhead=none, color="#777777"];
  label=<<b>A relation chain, and a sign after an operator</b>>;
  subgraph cluster_c0 {
    label=<<font face="DejaVu Sans Mono">x &lt; y \leq z   =   (y &lt;= z) &amp; (x &lt; y)</font>>; labeljust=l; style="rounded"; color="#bbbbbb"; margin=12;
  c0n0 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>latex_string</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">x &lt; y \leq z</font></td></tr><tr><td><font point-size="8" color="#888888">0:12</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c0n1 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>relation_chain</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">x &lt; y \leq z</font></td></tr><tr><td><font point-size="8" color="#888888">0:12</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#c8e6c9"];
  c0n2 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">SYMBOL</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>x</b></font></td></tr><tr><td><font point-size="8" color="#888888">0:1</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n1 -> c0n2;
  c0n3 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">LT</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>&lt;</b></font></td></tr><tr><td><font point-size="8" color="#888888">2:3</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n1 -> c0n3;
  c0n4 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">SYMBOL</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>y</b></font></td></tr><tr><td><font point-size="8" color="#888888">4:5</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n1 -> c0n4;
  c0n5 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">LTE</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>\leq</b></font></td></tr><tr><td><font point-size="8" color="#888888">6:10</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n1 -> c0n5;
  c0n6 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">SYMBOL</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>z</b></font></td></tr><tr><td><font point-size="8" color="#888888">11:12</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c0n1 -> c0n6;
  c0n0 -> c0n1;
  c0chart [shape=plaintext, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3"><tr><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>x</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>&nbsp;</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>&lt;</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>&nbsp;</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>y</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>&nbsp;</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>\</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>l</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>e</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>q</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>&nbsp;</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>z</b></font></td></tr><tr><td border="0"><font point-size="7" color="#888888">0</font></td><td border="0"><font point-size="7" color="#888888">1</font></td><td border="0"><font point-size="7" color="#888888">2</font></td><td border="0"><font point-size="7" color="#888888">3</font></td><td border="0"><font point-size="7" color="#888888">4</font></td><td border="0"><font point-size="7" color="#888888">5</font></td><td border="0"><font point-size="7" color="#888888">6</font></td><td border="0"><font point-size="7" color="#888888">7</font></td><td border="0"><font point-size="7" color="#888888">8</font></td><td border="0"><font point-size="7" color="#888888">9</font></td><td border="0"><font point-size="7" color="#888888">10</font></td><td border="0"><font point-size="7" color="#888888">11</font></td></tr><tr><td border="1" colspan="12" bgcolor="#fff3b0"><font point-size="9">latex_string</font></td></tr><tr><td border="1" colspan="12" bgcolor="#c8e6c9"><font point-size="9">relation_chain</font></td></tr><tr><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">SYMBOL</font></td><td border="0" colspan="1"></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">LT</font></td><td border="0" colspan="1"></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">SYMBOL</font></td><td border="0" colspan="1"></td><td border="1" colspan="4" bgcolor="#e8e8e8"><font point-size="9">LTE</font></td><td border="0" colspan="1"></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">SYMBOL</font></td></tr></table>>];
  c0n2 -> c0chart [style=invis, weight=0];
  c0n3 -> c0chart [style=invis, weight=0];
  c0n4 -> c0chart [style=invis, weight=0];
  c0n5 -> c0chart [style=invis, weight=0];
  c0n6 -> c0chart [style=invis, weight=0];
  }
  subgraph cluster_c1 {
    label=<<font face="DejaVu Sans Mono">a - -b   =   a + b</font>>; labeljust=l; style="rounded"; color="#bbbbbb"; margin=12;
  c1n0 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>latex_string</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">a - -b</font></td></tr><tr><td><font point-size="8" color="#888888">0:6</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c1n1 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>sub</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">a - -b</font></td></tr><tr><td><font point-size="8" color="#888888">0:6</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#fff3b0"];
  c1n2 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">SYMBOL</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>a</b></font></td></tr><tr><td><font point-size="8" color="#888888">0:1</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c1n1 -> c1n2;
  c1n3 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">SUB</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>-</b></font></td></tr><tr><td><font point-size="8" color="#888888">2:3</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c1n1 -> c1n3;
  c1n4 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><b>unary_sign</b></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="10">-b</font></td></tr><tr><td><font point-size="8" color="#888888">4:6</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#c8e6c9"];
  c1n5 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">SUB</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>-</b></font></td></tr><tr><td><font point-size="8" color="#888888">4:5</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c1n4 -> c1n5;
  c1n6 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr><td><font point-size="9" color="#555555">SYMBOL</font></td></tr><tr><td><font face="DejaVu Sans Mono" point-size="11"><b>b</b></font></td></tr><tr><td><font point-size="8" color="#888888">5:6</font></td></tr></table>>, shape=box, style="filled,rounded", fillcolor="#e8e8e8"];
  c1n4 -> c1n6;
  c1n1 -> c1n4;
  c1n0 -> c1n1;
  c1chart [shape=plaintext, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3"><tr><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>a</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>&nbsp;</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>-</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>&nbsp;</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>-</b></font></td><td border="1" bgcolor="#ffffff"><font face="DejaVu Sans Mono" point-size="12"><b>b</b></font></td></tr><tr><td border="0"><font point-size="7" color="#888888">0</font></td><td border="0"><font point-size="7" color="#888888">1</font></td><td border="0"><font point-size="7" color="#888888">2</font></td><td border="0"><font point-size="7" color="#888888">3</font></td><td border="0"><font point-size="7" color="#888888">4</font></td><td border="0"><font point-size="7" color="#888888">5</font></td></tr><tr><td border="1" colspan="6" bgcolor="#fff3b0"><font point-size="9">latex_string</font></td></tr><tr><td border="1" colspan="6" bgcolor="#fff3b0"><font point-size="9">sub</font></td></tr><tr><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">SYMBOL</font></td><td border="0" colspan="1"></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">SUB</font></td><td border="0" colspan="1"></td><td border="1" colspan="2" bgcolor="#c8e6c9"><font point-size="9">unary_sign</font></td></tr><tr><td border="0" colspan="4"></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">SUB</font></td><td border="1" colspan="1" bgcolor="#e8e8e8"><font point-size="9">SYMBOL</font></td></tr></table>>];
  c1n2 -> c1chart [style=invis, weight=0];
  c1n3 -> c1chart [style=invis, weight=0];
  c1n5 -> c1chart [style=invis, weight=0];
  c1n6 -> c1chart [style=invis, weight=0];
  }
}