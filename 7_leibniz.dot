digraph leibniz {
  rankdir=TB
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", fontname="Helvetica", fontsize=11]
  edge [fontname="Helvetica", fontsize=9]

  subgraph cluster_before {
    label="parse tree of \\frac{d^2 y}{dx^2}   (what Lark produces)"; style="rounded"; bgcolor="#f7f7ff"; fontsize=12
    f0 [label="fraction"]
    f1 [label="\\frac"]
    n0 [label="group_curly_parentheses"]
    n1 [label="adjacent_expressions"]
    n2 [label="superscript"]
    n3 [label="d"]
    n4 [label="2"]
    n5 [label="y"]
    d0 [label="group_curly_parentheses"]
    d1 [label="adjacent_expressions"]
    d2 [label="d"]
    d3 [label="superscript"]
    d4 [label="x"]
    d5 [label="2"]
    f0 -> {f1 n0 d0}
    n0 -> n1 -> {n2 n5}
    n2 -> {n3 n4}
    d0 -> d1 -> {d2 d3}
    d3 -> {d4 d5}
  }

  mark [label="TransformToSymPyExpr._mark_leibniz_notation\nruns on the tree before the transformation:\nnumerator starts with d or d^n, denominator starts with d\n=> the node is retagged leibniz_fraction\nwith children [d^n, f..., x^n]", fillcolor="#d9f2d9"]

  subgraph cluster_after {
    label="retagged node"; style="rounded"; bgcolor="#f7fff7"; fontsize=12
    l0 [label="leibniz_fraction", fillcolor="#d9f2d9"]
    l1 [label="superscript\nd^2"]
    l2 [label="y"]
    l3 [label="superscript\nx^2"]
    l0 -> {l1 l2 l3}
  }

  why [label="why a pre-pass: adjacent_expressions becomes a Mul,\nand a Mul does not remember which factor came first,\nso d can no longer be told apart from a variable\nafter the transformation", shape=note, fillcolor="#fff2cc"]

  subgraph cluster_result {
    label="leibniz_fraction in the transformer"; style="rounded,dashed"; fontsize=12
    r1 [label="\\frac{dy}{dx}, \\frac{d^2 y}{dx^2}\nDerivative(y, x), Derivative(y, (x, 2))", fillcolor="#d9f2d9"]
    r2 [label="\\frac{d}{dx} x^3\n_DerivativeOperator(x, 1), applied by\nadjacent_expressions to x**3", fillcolor="#d9f2d9"]
    r3 [label="\\frac{d}{dx} alone\nLaTeXParsingError:\nA derivative must be applied to an expression", fillcolor="#f8d7da"]
    r4 [label="\\frac{b d e}{d x}\nno d^n in front, or the orders differ:\na plain fraction b*d*e/(d*x) = b*e/x", fillcolor="#f0f0f0"]
  }

  f0 -> mark [style=dashed]
  mark -> l0 [style=dashed]
  mark -> why [style=dashed]
  l0 -> {r1 r2 r3 r4} [style=dashed]
}
